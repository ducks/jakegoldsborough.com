&lt;span class=&quot;giallo-l&quot;&gt;&lt;span style=&quot;color: #A89984;&quot;&gt;        @&lt;/span&gt;&lt;span style=&quot;color: #83A598;&quot;&gt;output&lt;/span&gt;&lt;span style=&quot;color: #8EC07C;&quot;&gt; &amp;lt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color: #A89984;&quot;&gt; &amp;quot;#{&amp;#39; &amp;#39;&lt;/span&gt;&lt;span style=&quot;color: #8EC07C;&quot;&gt; *&lt;/span&gt;&lt;span style=&quot;color: #B8BB26;&quot;&gt; indent&lt;/span&gt;&lt;span style=&quot;color: #A89984;&quot;&gt;}#{&lt;/span&gt;&lt;span style=&quot;color: #B8BB26;&quot;&gt;key_str&lt;/span&gt;&lt;span style=&quot;color: #A89984;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #B8BB26;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: #A89984;&quot;&gt;#{&lt;/span&gt;&lt;span style=&quot;color: #B8BB26;&quot;&gt;value_str&lt;/span&gt;&lt;span style=&quot;color: #A89984;&quot;&gt;}&amp;quot;&lt;/span&gt;&lt;/span&gt;
